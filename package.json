{
  "name": "ecard-pass-and-play",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "fix": "expo install --fix",
    "doctor": "npx expo-doctor",
    "typecheck": "tsc --noEmit",
    "relay": "node server/relay.js",
    "selftest": "node --experimental-strip-types --no-warnings --import ./scripts/register.mjs scripts/selftest.ts"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "*",
    "@expo-google-fonts/bebas-neue": "*",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "~54.0.37",
    "expo-blur": "~15.0.7",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-nearby-connections": "^1.1.1",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-tcp-socket": "^6.4.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket"
        ]
      }
    }
  }
}
